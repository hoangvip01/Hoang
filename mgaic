local function collectAllLoot()
    for _,obj in pairs(workspace:GetDescendants()) do
        local name=obj.Name:lower()
        local ok=name:find("exp") or name:find("xp") or name:find("drop")
            or name:find("loot") or name:find("coin") or name:find("gold")
            or name:find("orb") or name:find("soul") or name:find("gem")
        if ok then
            if obj:IsA("BasePart") then
                local d=(obj.Position-hrp.Position).Magnitude
                if d<CONFIG.DROP_RANGE then
                    local sv=hrp.CFrame
                    hrp.CFrame=CFrame.new(obj.Position)
                    task.wait(0.04); hrp.CFrame=sv
                end
            end
            if obj:IsA("RemoteEvent") then pcall(function() obj:FireServer() end) end
        end
    end
    for _,r in pairs(game.ReplicatedStorage:GetDescendants()) do
        if r:IsA("RemoteEvent") then
            local n=r.Name:lower()
            if n:find("collect") or n:find("pickup") or n:find("exp")
            or n:find("reward") or n:find("claim") then
                pcall(function() r:FireServer() end)
            end
        end
    end
end

spawn(function() while true do if CONFIG.AutoEXP then collectAllLoot() end task.wait(0.4) end end)

local function attackMonster(monster)
    if not monster then return end
    local mH=monster:FindFirstChild("Humanoid"); if not mH then return end
    local tool=character:FindFirstChildOfClass("Tool"); if tool then tool:Activate() end
    for _,r in pairs(game.ReplicatedStorage:GetDescendants()) do
        if r:IsA("RemoteEvent") then
            local n=r.Name:lower()
            if n:find("attack") or n:find("damage") or n:find("hit") then
                pcall(function() r:FireServer(monster) end)
            end
        end
    end
    pcall(function() if mH.Health>0 then mH.Health=0 end end)
end

