-- FIX LAG — port từ Utility Menu v6.3
-- Mode nhẹ: tắt FX, giảm quality, GIỮ màu gốc
-- ═══════════════════════════════════════════════
local FX_KILL = {
    "ParticleEmitter","Trail","Beam","Smoke","Fire","Sparkles",
    "PointLight","SpotLight","SurfaceLight",
    "BloomEffect","BlurEffect","SunRaysEffect","ColorCorrectionEffect",
    "DepthOfFieldEffect","Highlight","SelectionBox","SelectionSphere",
    "Explosion","Decal","Texture","SurfaceAppearance",
}

local FixLag = {
    enabled=false, saved={}, hidden={}, conns={},
    lightingSaved=nil, heartbeat=nil, throttle=0, terrainSaved=nil,
}

local function fxRemember(tbl, inst, prop, newVal)
    if not inst.Parent then return end
    local e = tbl.saved[inst]
    if not e then e={}; tbl.saved[inst]=e end
    if e[prop]==nil then e[prop]=inst[prop] end
    pcall(function() inst[prop]=newVal end)
end

function FixLag:_process(inst)
    if not inst or not inst.Parent then return end
    if isProtected(inst) then return end
    for _, cls in ipairs(FX_KILL) do
        if inst:IsA(cls) then
            if cls=="SurfaceAppearance" then
                if not self.hidden[inst] then
                    self.hidden[inst]=inst.Parent; inst.Parent=nil
                end
            elseif cls=="Decal" or cls=="Texture" then
                fxRemember(self, inst, "Transparency", 1)
            else
                fxRemember(self, inst, "Enabled", false)
            end
            return
        end
    end
    if inst:IsA("Atmosphere") then
        fxRemember(self, inst, "Enabled", false)
        fxRemember(self, inst, "Density", 0)
        return
    end
    if inst:IsA("Clouds") then
        fxRemember(self, inst, "Enabled", false)
        fxRemember(self, inst, "Cover", 0)
        return
    end
    if inst:IsA("BasePart") then
        fxRemember(self, inst, "CastShadow", false)
        fxRemember(self, inst, "Material", Enum.Material.SmoothPlastic)
        if inst:IsA("MeshPart") then
            fxRemember(self, inst, "TextureID", "")
            fxRemember(self, inst, "RenderFidelity", Enum.RenderFidelity.Performance)
        end
    end
    if inst:IsA("Sound") then fxRemember(self, inst, "Volume", 0) end
    if inst:IsA("Humanoid") then
        fxRemember(self, inst, "DisplayDistanceType", Enum.HumanoidDisplayDistanceType.None)
    end
end

function FixLag:_applyTo(container)
    if not container then return end
    for _, d in ipairs(container:GetDescendants()) do self:_process(d) end
end

function FixLag:start()
    if self.enabled then return end
    self.enabled=true; self.saved={}; self.hidden={}
    self:_applyTo(workspace)
    self:_applyTo(Lighting)
    if workspace.Terrain then
        self.terrainSaved = {
            Decoration        = workspace.Terrain.Decoration,
            WaterWaveSize     = workspace.Terrain.WaterWaveSize,
            WaterTransparency = workspace.Terrain.WaterTransparency,
            WaterReflectance  = workspace.Terrain.WaterReflectance,
        }
        workspace.Terrain.Decoration=false
        workspace.Terrain.WaterWaveSize=0
        workspace.Terrain.WaterTransparency=0.5
        workspace.Terrain.WaterReflectance=0
    end
    self.lightingSaved = {
        GlobalShadows             = Lighting.GlobalShadows,
        EnvironmentDiffuseScale   = Lighting.EnvironmentDiffuseScale,
        EnvironmentSpecularScale  = Lighting.EnvironmentSpecularScale,
        ShadowSoftness            = Lighting.ShadowSoftness,
    }
    Lighting.GlobalShadows=false
    Lighting.EnvironmentDiffuseScale=0
    Lighting.EnvironmentSpecularScale=0
    Lighting.ShadowSoftness=0
    pcall(function()
        UserSettings():GetService("UserGameSettings").SavedQualityLevel =
            Enum.SavedQualitySetting.QualityLevel1
    end)
    self.heartbeat = RunService.Heartbeat:Connect(function()
        if not self.enabled then return end
        self.throttle+=1
        if self.throttle<60 then return end
        self.throttle=0
        self:_applyTo(workspace)
    end)
    table.insert(self.conns, workspace.DescendantAdded:Connect(function(d)
        if self.enabled then self:_process(d) end
    end))
    table.insert(self.conns, Lighting.DescendantAdded:Connect(function(d)
        if self.enabled then self:_process(d) end
    end))
end

function FixLag:stop()
    if not self.enabled then return end
    self.enabled=false
    if self.heartbeat then self.heartbeat:Disconnect(); self.heartbeat=nil end
    for inst, props in pairs(self.saved) do
        if inst and inst.Parent then
            for prop, val in pairs(props) do pcall(function() inst[prop]=val end) end
        end
    end
    self.saved={}
    for inst, parent in pairs(self.hidden) do
        if inst and parent then pcall(function() inst.Parent=parent end) end
    end
    self.hidden={}
    if self.terrainSaved and workspace.Terrain then
        workspace.Terrain.Decoration        = self.terrainSaved.Decoration
        workspace.Terrain.WaterWaveSize     = self.terrainSaved.WaterWaveSize
        workspace.Terrain.WaterTransparency = self.terrainSaved.WaterTransparency
        workspace.Terrain.WaterReflectance  = self.terrainSaved.WaterReflectance
        self.terrainSaved=nil
    end
    if self.lightingSaved then
        for k,v in pairs(self.lightingSaved) do pcall(function() Lighting[k]=v end) end
        self.lightingSaved=nil
    end
    pcall(function()
        UserSettings():GetService("UserGameSettings").SavedQualityLevel =
            Enum.SavedQualitySetting.Automatic
    end)
    for _, c in ipairs(self.conns) do c:Disconnect() end
    self.conns={}
end

