        if cfgKey=="FlyHack" and CONFIG.FlyHack then enableFly() end
        if CONFIG[cfgKey] and onCallback then onCallback() end
        if not CONFIG[cfgKey] and offCallback then offCallback() end
        saveConfig()
    end
    tog.MouseButton1Click:Connect(doToggle); tog.TouchTap:Connect(doToggle)
    return row
