local function teleportTo(pos)
    if hrp then hrp.CFrame = CFrame.new(pos) end
end
local function fireByKW(kw)
    for _, r in pairs(game.ReplicatedStorage:GetDescendants()) do
        if r:IsA("RemoteEvent") and r.Name:lower():find(kw) then
            pcall(function() r:FireServer() end)
        end
    end
end
local function findNearestMonster()
    local nearest, minDist = nil, math.huge
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj ~= character then
            local mH = obj:FindFirstChild("Humanoid")
            local mR = obj:FindFirstChild("HumanoidRootPart")
            if mH and mR and mH.Health > 0 and not Players:GetPlayerFromCharacter(obj) then
                local d = (mR.Position - hrp.Position).Magnitude
                if d < minDist then minDist=d; nearest=obj end
            end
        end
    end
    return nearest
end
local PROTECT_KWS = {"rương","ruong","chest","treasure","fruit","devil","loot","drop","item"}
local function isProtected(inst)
    if not inst or not inst.Parent then return true end
    local myChar = LocalPlayer.Character
    if myChar and (inst == myChar or inst:IsDescendantOf(myChar)) then return true end
    local n = inst.Name:lower()
    for _, k in ipairs(PROTECT_KWS) do if n:find(k,1,true) then return true end end
    if inst:FindFirstChildWhichIsA("ProximityPrompt", false) then return true end
    if inst:FindFirstChildWhichIsA("ClickDetector", false) then return true end
    return false
end

