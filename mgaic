local FARM_GRAY = Color3.fromRGB(110,110,110)
local FARM_FX = {
    "ParticleEmitter","Trail","Beam","Smoke","Fire","Sparkles",
    "PointLight","SpotLight","SurfaceLight",
    "BloomEffect","BlurEffect","SunRaysEffect","ColorCorrectionEffect",
    "DepthOfFieldEffect","Highlight","SelectionBox","SelectionSphere",
    "Explosion","Decal","Texture","SurfaceAppearance","SurfaceGui","BillboardGui",
}

local FarmClean = {
    enabled=false, saved={}, hidden={},
    hiddenSky=nil, hiddenClouds=nil, hiddenAtmosphere=nil,
    conns={}, lightingSaved=nil, heartbeat=nil, throttle=0, terrainSaved=nil,
}

local function farmRemember(tbl, inst, prop, newVal)
    if not inst.Parent then return end
    local e = tbl.saved[inst]
    if not e then e={}; tbl.saved[inst]=e end
    if e[prop]==nil then e[prop]=inst[prop] end
    pcall(function() inst[prop]=newVal end)
end

function FarmClean:_process(inst)
    if not inst or not inst.Parent then return end
    if isProtected(inst) then return end

    -- Ẩn Sky/Clouds/Atmosphere -> trời thành 1 khối xanh
    if inst:IsA("Sky") then
        if not self.hiddenSky then
            self.hiddenSky={inst=inst,parent=inst.Parent}; inst.Parent=nil
        end; return
    end
    if inst:IsA("Clouds") then
        if not self.hiddenClouds then
            self.hiddenClouds={inst=inst,parent=inst.Parent}; inst.Parent=nil
        end; return
    end
    if inst:IsA("Atmosphere") then
        if not self.hiddenAtmosphere then
            self.hiddenAtmosphere={inst=inst,parent=inst.Parent}; inst.Parent=nil
        end; return
    end

    for _, cls in ipairs(FARM_FX) do
        if inst:IsA(cls) then
            if cls=="SurfaceAppearance" then
                if not self.hidden[inst] then
                    self.hidden[inst]=inst.Parent; inst.Parent=nil
                end
            elseif cls=="SurfaceGui" then
                if inst:IsDescendantOf(workspace) then
                    farmRemember(self,inst,"Enabled",false)
                end
            elseif cls=="BillboardGui" then
                farmRemember(self,inst,"Enabled",false)
            elseif cls=="Decal" or cls=="Texture" then
                farmRemember(self,inst,"Transparency",1)
            else
                farmRemember(self,inst,"Enabled",false)
            end
            return
        end
    end

    -- Mọi BasePart -> XÁM phẳng
    if inst:IsA("BasePart") then
        farmRemember(self,inst,"Color",FARM_GRAY)
        farmRemember(self,inst,"Material",Enum.Material.SmoothPlastic)
        farmRemember(self,inst,"CastShadow",false)
        farmRemember(self,inst,"Reflectance",0)
        if inst:IsA("MeshPart") then
            farmRemember(self,inst,"TextureID","")
            farmRemember(self,inst,"RenderFidelity",Enum.RenderFidelity.Performance)
        end
        return
    end

    if inst:IsA("Accessory") or inst:IsA("Hat") then
        local h = inst:FindFirstChild("Handle")
        if h then
            farmRemember(self,h,"Transparency",1)
            farmRemember(self,h,"LocalTransparencyModifier",1)
        end
        return
    end
    if inst:IsA("Sound") then farmRemember(self,inst,"Volume",0) return end
    if inst:IsA("Humanoid") then
        farmRemember(self,inst,"DisplayDistanceType",Enum.HumanoidDisplayDistanceType.None)
    end
end

function FarmClean:_applyTo(container)
    if not container then return end
    for _, d in ipairs(container:GetDescendants()) do self:_process(d) end
end

function FarmClean:start()
    if self.enabled then return end
    self.enabled=true; self.saved={}; self.hidden={}
    self:_applyTo(workspace)
    self:_applyTo(Lighting)
    -- Nước biển = xanh đặc, không sóng
    if workspace.Terrain then
        self.terrainSaved = {
            WaterColor        = workspace.Terrain.WaterColor,
            Decoration        = workspace.Terrain.Decoration,
            WaterWaveSize     = workspace.Terrain.WaterWaveSize,
            WaterTransparency = workspace.Terrain.WaterTransparency,
            WaterReflectance  = workspace.Terrain.WaterReflectance,
        }
        workspace.Terrain.WaterColor        = Color3.fromRGB(30,100,160)
        workspace.Terrain.Decoration        = false
        workspace.Terrain.WaterWaveSize     = 0
        workspace.Terrain.WaterTransparency = 0
        workspace.Terrain.WaterReflectance  = 0
    end
    self.lightingSaved = {
        GlobalShadows            = Lighting.GlobalShadows,
        EnvironmentDiffuseScale  = Lighting.EnvironmentDiffuseScale,
        EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
        ShadowSoftness           = Lighting.ShadowSoftness,
        Ambient                  = Lighting.Ambient,
        OutdoorAmbient           = Lighting.OutdoorAmbient,
    }
    Lighting.GlobalShadows=false
    Lighting.EnvironmentDiffuseScale=0
    Lighting.EnvironmentSpecularScale=0
    Lighting.ShadowSoftness=0
    Lighting.Ambient=Color3.fromRGB(180,180,180)
    Lighting.OutdoorAmbient=Color3.fromRGB(180,180,180)
    pcall(function()
        UserSettings():GetService("UserGameSettings").SavedQualityLevel =
            Enum.SavedQualitySetting.QualityLevel1
    end)
    self.heartbeat = RunService.Heartbeat:Connect(function()
        if not self.enabled then return end
        self.throttle+=1
        if self.throttle<60 then return end
        self.throttle=0
        self:_applyTo(workspace)
    end)
    table.insert(self.conns, workspace.DescendantAdded:Connect(function(d)
        if self.enabled then self:_process(d) end
    end))
end

function FarmClean:stop()
    if not self.enabled then return end
    self.enabled=false
    if self.heartbeat then self.heartbeat:Disconnect(); self.heartbeat=nil end
    -- Restore Sky/Clouds/Atmosphere
    if self.hiddenSky and self.hiddenSky.inst then
        pcall(function() self.hiddenSky.inst.Parent=self.hiddenSky.parent end)
        self.hiddenSky=nil
    end
    if self.hiddenClouds and self.hiddenClouds.inst then
        pcall(function() self.hiddenClouds.inst.Parent=self.hiddenClouds.parent end)
        self.hiddenClouds=nil
    end
    if self.hiddenAtmosphere and self.hiddenAtmosphere.inst then
        pcall(function() self.hiddenAtmosphere.inst.Parent=self.hiddenAtmosphere.parent end)
        self.hiddenAtmosphere=nil
    end
    for inst, props in pairs(self.saved) do
        if inst and inst.Parent then
            for prop, val in pairs(props) do pcall(function() inst[prop]=val end) end
        end
    end
    self.saved={}
    for inst, parent in pairs(self.hidden) do
        if inst and parent then pcall(function() inst.Parent=parent end) end
    end
    self.hidden={}
    if self.terrainSaved and workspace.Terrain then
        for k,v in pairs(self.terrainSaved) do
            pcall(function() workspace.Terrain[k]=v end)
        end
        self.terrainSaved=nil
    end
    if self.lightingSaved then
        for k,v in pairs(self.lightingSaved) do pcall(function() Lighting[k]=v end) end
        self.lightingSaved=nil
    end
    pcall(function()
        UserSettings():GetService("UserGameSettings").SavedQualityLevel =
            Enum.SavedQualitySetting.Automatic
    end)
    for _, c in ipairs(self.conns) do c:Disconnect() end
    self.conns={}
end

