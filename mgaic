Instance.new("UICorner",infoLbl).CornerRadius=UDim.new(0,8)
local ip=Instance.new("UIPadding",infoLbl)
ip.PaddingLeft=UDim.new(0,10); ip.PaddingTop=UDim.new(0,8)

-- ═══ MOBILE TOGGLE ═══
local TogBtn=Instance.new("TextButton",ScreenGui)
TogBtn.Size=UDim2.new(0,54,0,54); TogBtn.Position=UDim2.new(0,8,0.5,-27)
TogBtn.BackgroundColor3=Color3.fromRGB(20,20,40); TogBtn.Text="⚡"
TogBtn.TextColor3=Color3.new(1,1,1); TogBtn.Font=Enum.Font.GothamBold
TogBtn.TextSize=26; TogBtn.BorderSizePixel=0; TogBtn.ZIndex=20
Instance.new("UICorner",TogBtn).CornerRadius=UDim.new(1,0)
local st=Instance.new("UIStroke",TogBtn); st.Color=Color3.fromRGB(120,55,220); st.Thickness=2

local tgDS,tgO,tgM
TogBtn.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
        tgDS=i.Position; tgO=TogBtn.Position; tgM=false
    end
end)
TogBtn.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
        if not tgM then MainFrame.Visible=not MainFrame.Visible end; tgDS=nil
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if tgDS and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
        local d=i.Position-tgDS
        if d.Magnitude>6 then
            tgM=true
            TogBtn.Position=UDim2.new(tgO.X.Scale,tgO.X.Offset+d.X,tgO.Y.Scale,tgO.Y.Offset+d.Y)
        end
    end
end)

-- ═══ KEYBINDS ═══
UserInputService.InputBegan:Connect(function(i,gp)
    if gp then return end
    if i.KeyCode==Enum.KeyCode.Insert then MainFrame.Visible=not MainFrame.Visible
    elseif i.KeyCode==Enum.KeyCode.F1 then CONFIG.FlyHack=not CONFIG.FlyHack; if CONFIG.FlyHack then enableFly() end
    elseif i.KeyCode==Enum.KeyCode.F2 then CONFIG.Noclip=not CONFIG.Noclip
    elseif i.KeyCode==Enum.KeyCode.F3 then CONFIG.ESP=not CONFIG.ESP
    elseif i.KeyCode==Enum.KeyCode.F4 then CONFIG.Aimbot=not CONFIG.Aimbot
    elseif i.KeyCode==Enum.KeyCode.F5 then CONFIG.GodMode=not CONFIG.GodMode
    end
end)

